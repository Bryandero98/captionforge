# Copia este archivo a .env y rellena los valores. .env NO se sube a git.
# Usa solo letras y números en las contraseñas (van dentro de URLs de conexión sin codificar).
# Genera una así:  node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"

# --- Obligatorias ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
CF_OWNER_DB_PASSWORD=          # dueño del esquema: solo lo ve el servicio migrate
CF_API_DB_PASSWORD=
CF_WORKER_DB_PASSWORD=
REDIS_PASSWORD=
S3_ROOT_PASSWORD=             # mínimo 8 caracteres
S3_API_SECRET_KEY=            # mínimo 8 caracteres
S3_WORKER_SECRET_KEY=         # mínimo 8 caracteres

# --- Opcionales (valores por defecto entre paréntesis) --------------------------------------
# POSTGRES_USER=captionforge          # superusuario del contenedor: solo lo usa pg-roles
# POSTGRES_DB=captionforge
# S3_ROOT_USER=captionforge
# S3_BUCKET=captionforge
# S3_CONSOLE_ENABLE=true             # false en despliegue
# S3_API_ACCESS_KEY=cf-api
# S3_WORKER_ACCESS_KEY=cf-worker
# MAX_UPLOAD_BYTES=4294967296         # 4 GiB

# Clave de API del tenant "Default" (ADR 0015). Todas las rutas de /v1 exigen `X-API-Key: <clave>` (o `Authorization:
# Bearer`); /health y /v1/capabilities quedan abiertos. El servicio migrate la da de alta y la interfaz web local la
# recibe sola. start.sh / start.bat la generan; a mano: `cfk_` + `openssl rand -hex 32`. Cambiarla aquí rota la clave:
# la anterior queda revocada en el siguiente arranque.
DEFAULT_API_KEY=
# RATE_LIMIT_PER_MINUTE=240             # peticiones por IP y minuto (0 = sin límite)
# UPLOAD_RATE_LIMIT_PER_MINUTE=10       # subidas de video por IP y minuto, contador aparte (0 = sin límite)
# MAX_CONCURRENT_UPLOADS=4              # subidas a la vez en todo el API (cada una retiene ~15 MiB); 503 al pasarse (0 = sin límite)
# MAX_CONCURRENT_UPLOADS_PER_CLIENT=2   # subidas a la vez por IP (IPv6 agrupado por /64); 429 al pasarse (0 = sin límite)
# UPLOAD_MIN_BYTES_PER_SECOND=16384     # ritmo mínimo de una subida por ventana; por debajo se corta con 408 (0 = sin mínimo)
# UPLOAD_RATE_WINDOW_SECONDS=30         # ventana en la que se mide ese ritmo
# MAX_EVENT_STREAMS=200                 # flujos SSE abiertos a la vez en total; 503 al pasarse (0 = sin límite)
# MAX_EVENT_STREAMS_PER_CLIENT=10       # flujos SSE abiertos por IP; 429 al pasarse (0 = sin límite)
# EVENT_STREAM_MAX_SECONDS=1800         # duración máxima de un flujo SSE; el cliente reconecta solo (0 = sin límite)
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]  # nombres con los que se llega al API, sin puerto ni comodines; otro Host recibe 421 (anti DNS rebinding). Añade el tuyo si lo publicas
# ALLOWED_ORIGINS=                      # orígenes de navegador autorizados (CORS y CSRF), p. ej. http://localhost:5173; vacío = solo mismo origen; nunca *
# WEB_ROOT=                            # carpeta de la interfaz web que sirve el API (por defecto apps/web/public, mismo origen: sin CORS); off = solo API
# TRUST_PROXY=false                     # detrás de un proxy: su IP o red (p. ej. 10.0.0.0/8); "true" confía en TODA X-Forwarded-For y se esquiva rotándola
# JOB_STALE_MINUTES=20                  # un trabajo RUNNING sin cambios durante este tiempo se cierra como fallido
# WHISPER_DEFAULT_MODEL=small         # base | small | medium
# WORKER_MEM_LIMIT=4g
# SHUTDOWN_GRACE_SECONDS=45              # al apagar el worker, plazo para que termine el trabajo en curso; pasado, se cierra como fallido

# Identificar quién habla (opcional, ADR 0014). Requiere construir el worker con --build-arg WITH_DIARIZATION=1 y un token de
# Hugging Face de SOLO LECTURA, con las condiciones de pyannote/speaker-diarization-3.1 y pyannote/segmentation-3.0 aceptadas.
# El token lo recibe solo el worker; el API solo sabe si la función está disponible. Sin token la casilla no aparece en la web.
# HF_TOKEN=
# DIARIZATION_ENABLED=                  # true | false; vacío = se enciende si hay HF_TOKEN
# DIARIZATION_STALL_TIMEOUT_SECONDS=600 # sin señal del subproceso durante este tiempo se da por colgado y se entrega la transcripción normal
# DIARIZATION_TOTAL_TIMEOUT_SECONDS=7200

# Inicio de sesión de personas (ADR 0016). Con LOCAL_MODE=true (por defecto) es una instalación de una sola persona: la interfaz usa
# la DEFAULT_API_KEY y no pide entrar. Con LOCAL_MODE=false la interfaz pide entrar con GitHub o Google y no recibe ninguna clave.
# LOCAL_MODE=true
# GitHub: crea una OAuth App con callback http://localhost:3000/auth/github/callback (o tu PUBLIC_URL + /auth/github/callback)
# y pega aquí su Client ID y su Client Secret (nunca en el chat ni en git). Google: lo mismo con /auth/google/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Dirección pública del servicio (esquema://host[:puerto], sin ruta): arma el callback y activa cookies Secure si es https.
# PUBLIC_URL=http://localhost:3000
# SESSION_TTL_DAYS=30
