{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captionforge.dev/schemas/translate-job.v1.json",
  "title": "TranslateJob",
  "description": "Payload de la cola captionforge.translate: traduce segments.json conservando los tiempos. Nunca lleva claves externas: el worker las pide al API (ADR 0020).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "requestedAt", "segments", "outputPrefix", "options"],
  "properties": {
    "schemaVersion": { "description": "Siempre 1 en este esquema.", "type": "integer", "minimum": 1, "maximum": 1 },
    "jobId": { "$ref": "common.v1.json#/$defs/Uuid" },
    "requestedAt": { "$ref": "common.v1.json#/$defs/IsoDateTime" },
    "segments": {
      "description": "segments.json de origen; el worker falla con SEGMENTS_CHANGED si su ETag ya no coincide.",
      "$ref": "common.v1.json#/$defs/VersionedObjectRef"
    },
    "outputPrefix": { "$ref": "common.v1.json#/$defs/ObjectPrefix" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourceLanguage", "targetLanguage"],
      "properties": {
        "provider": { "$ref": "common.v1.json#/$defs/TranslateProvider" },
        "sourceLanguage": { "$ref": "common.v1.json#/$defs/LanguageCode" },
        "targetLanguage": { "$ref": "common.v1.json#/$defs/LanguageCode" }
      }
    }
  }
}
