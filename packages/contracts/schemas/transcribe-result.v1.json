{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captionforge.dev/schemas/transcribe-result.v1.json",
  "title": "TranscribeResult",
  "description": "returnvalue del trabajo de transcripción.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "detectedLanguage",
    "device",
    "durationSeconds",
    "segmentCount",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "description": "Siempre 1 en este esquema.", "type": "integer", "minimum": 1, "maximum": 1 },
    "jobId": { "$ref": "common.v1.json#/$defs/Uuid" },
    "detectedLanguage": { "$ref": "common.v1.json#/$defs/LanguageCode" },
    "device": { "type": "string", "enum": ["cpu", "cuda"] },
    "durationSeconds": { "type": "number", "minimum": 0 },
    "segmentCount": { "type": "integer", "minimum": 0 },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["srt", "segments", "waveform"],
      "properties": {
        "srt": { "$ref": "common.v1.json#/$defs/ObjectKey" },
        "segments": { "$ref": "common.v1.json#/$defs/VersionedObjectRef" },
        "waveform": { "$ref": "common.v1.json#/$defs/ObjectKey" }
      }
    }
  }
}
