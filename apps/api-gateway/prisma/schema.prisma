// Esquema de CaptionForge. Prisma es la ÚNICA fuente de verdad: las tablas las crea `prisma migrate
// deploy` con el rol cf_owner. El worker de Python solo lee y actualiza las columnas que concede la
// migración "init" (ver el bloque de GRANT al final de ese SQL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum JobKind {
  TRANSCRIBE
  BURN
  /// Traducir los subtítulos de una transcripción terminada (ADR 0020).
  TRANSLATE
  /// Doblar (texto a voz) los subtítulos de una transcripción terminada (ADR 0020).
  DUB
}

/// Proveedores externos con clave propia del espacio de trabajo (ADR 0020). Argos es local y no usa clave.
enum ExternalProvider {
  openai
  elevenlabs
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Espacio de trabajo: la unidad de aislamiento. Todo Job pertenece a un Tenant y nadie ve los de otro (ADR 0015).
// En la Fase 5b cada persona tiene el suyo (1 persona = 1 tenant), pero el modelo ya admite varias personas por tenant.
model Tenant {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @default(now())

  users        User[]
  apiKeys      ApiKey[]
  jobs         Job[]
  memberships  Membership[]
  sessions     Session[]
  invitations  Invitation[]
  externalKeys TenantExternalKey[]
}

// Persona. `provider` + `subject` identifican la cuenta en el proveedor de inicio de sesión (github, google): los
// rellena el issue #7; hasta entonces quedan vacíos.
model User {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid
  email     String?  @unique
  name      String?
  provider  String?
  subject   String?
  createdAt DateTime @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions            Session[]
  memberships         Membership[]
  invitationsCreated  Invitation[]        @relation("InvitationCreator")
  invitationsAccepted Invitation[]        @relation("InvitationAcceptor")
  apiKeysCreated      ApiKey[]            @relation("ApiKeyCreator")
  externalKeysCreated TenantExternalKey[] @relation("ExternalKeyCreator")

  @@unique([provider, subject])
  @@index([tenantId])
}

// Sesión de navegador tras iniciar sesión con GitHub o Google (ADR 0016). La cookie lleva un token aleatorio de 256 bits y
// aquí solo se guarda su SHA-256: un volcado de la tabla no da sesiones utilizables. Caduca a los 30 días.
model Session {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  /// Espacio de trabajo activo; nulo = el primero de la persona (ADR 0019).
  tenantId  String?  @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// Clave de API de un tenant para scripts y servicios. El valor completo solo se ve al crearla: aquí se guarda su
// SHA-256 (las claves son aleatorias de 256 bits, así que no hace falta un hash lento) y un prefijo para reconocerla.
model ApiKey {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  prefix     String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  /// Quién la creó (ADR 0019): al dejar de ser Dueño del espacio, sus claves se revocan. Nula en las anteriores a esta columna.
  createdBy  String?   @db.Uuid

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User?  @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdBy])
}

model Job {
  id       String    @id @db.Uuid
  tenantId String    @db.Uuid
  kind     JobKind
  status   JobStatus @default(QUEUED)

  // Progreso (lo actualiza el worker): etapa del contrato job-progress y porcentaje 0-100.
  stage   String?
  percent Float   @default(0)
  message String?

  // Archivo de entrada y prefijo de salida, siempre como bucket + objectKey (ADR 0002).
  inputBucket      String
  inputKey         String
  originalFilename String
  contentType      String
  sizeBytes        BigInt
  outputPrefix     String
  options          Json

  // Un trabajo de quemado apunta a la transcripción de la que parte.
  parentJobId String? @db.Uuid

  // Resultado: errorCode es un código del contrato job-error; result es transcribe/burn-result.
  errorCode    String?
  errorMessage String?
  result       Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([parentJobId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

/// Permisos de una persona en un espacio de trabajo (ADR 0019).
enum Role {
  OWNER
  EDITOR
  VIEWER
}

/// Una persona puede ser miembro de varios espacios, con un rol en cada uno. Un espacio con miembros no se borra.
model Membership {
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, tenantId])
  @@index([tenantId])
}

/// Enlace mágico para unirse a un espacio de trabajo (ADR 0019): un solo uso, 7 días. Solo se guarda el SHA-256 del token.
model Invitation {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  /// Rol que recibe quien acepta; nunca OWNER (el Dueño se promueve después).
  role       Role
  tokenHash  String    @unique
  createdBy  String    @db.Uuid
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String?   @db.Uuid
  revokedAt  DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator  User   @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  acceptor User?  @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

/// Clave de un proveedor externo (OpenAI, ElevenLabs) que un espacio de trabajo aporta para delegar cómputo (ADR 0020). `ciphertext`
/// es `v1.<iv>.<etiqueta>.<datos>` (AES-256-GCM con AAD tenantId|provider|keyVersion): el valor en claro NUNCA se guarda. `cf_worker` no
/// tiene ningún permiso sobre esta tabla: el worker pide la clave al API por el canal interno.
model TenantExternalKey {
  id         String           @id @db.Uuid
  tenantId   String           @db.Uuid
  provider   ExternalProvider
  ciphertext String
  keyVersion Int              @default(1)
  /// Últimos 4 caracteres para reconocerla en la interfaz; vacío si la clave es corta.
  last4      String
  /// Quién la pegó (solo auditoría): la clave es del espacio y no se revoca si esa persona deja de ser Dueño.
  createdBy  String?          @db.Uuid
  createdAt  DateTime         @default(now())
  rotatedAt  DateTime?

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User?  @relation("ExternalKeyCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider])
  @@index([createdBy])
}
